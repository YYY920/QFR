XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_REDIRECT_URI=http://localhost:51789/callback
XERO_TENANT_ID=

# Primary AI mapping key (preferred), with OPENAI_API_KEY as a fallback.
OPENAI_API_KEY_QFR=your_openai_key
# OPENAI_API_KEY=your_openai_key

# Mapping concurrency and per-request timeout defaults.
AI_MAPPING_WORKERS=4
OPENAI_TIMEOUT_SECONDS=30

# Optional legacy mapper; run_mvp.py does not use Gemini.
# GEMINI_API_KEY=your_gemini_key
